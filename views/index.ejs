<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tic-Tac-Toe with AI</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="./css/style.css">

</head>
<body class="theme-default">
<div class="game-container">
    <div class="game-header">
        <i class="fas fa-robot logo"></i>
        <h1>Tic-Tac-Toe</h1>
        <i class="fas fa-gamepad logo"></i>
    </div>

    <div class="status" id="status">Your turn (X)</div>

    <div class="player-info">
        <div class="player active" id="player-x">
            <div class="player-icon">X</div>
            <div class="player-name">You</div>
        </div>
        <div class="player" id="player-o">
            <div class="player-icon">O</div>
            <div class="player-name">AI</div>
        </div>
    </div>

    <div class="difficulty-selector">
        <div class="difficulty-label">AI Difficulty:</div>
        <div class="difficulty-options">
            <div class="difficulty-option active" data-difficulty="easy">Easy</div>
            <div class="difficulty-option" data-difficulty="medium">Medium</div>
            <div class="difficulty-option" data-difficulty="hard">Hard</div>
        </div>
    </div>

    <div class="board" id="board">
        <!-- Cells will be generated by JavaScript -->
    </div>

    <div class="game-stats">
        <div class="stat">
            <div class="stat-value" id="wins">0</div>
            <div class="stat-label">Wins</div>
        </div>
        <div class="stat">
            <div class="stat-value" id="losses">0</div>
            <div class="stat-label">Losses</div>
        </div>
        <div class="stat">
            <div class="stat-value" id="draws">0</div>
            <div class="stat-label">Draws</div>
        </div>
    </div>

    <div class="controls">
        <button id="restart"><i class="fas fa-redo"></i> New Game</button>
        <button id="switch"><i class="fas fa-exchange-alt"></i> Switch Sides</button>
    </div>

    <div class="theme-selector">
        <div class="theme-option active" data-theme="default" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>
        <div class="theme-option" data-theme="dark" style="background: linear-gradient(135deg, #2d3436 0%, #636e72 100%);"></div>
        <div class="theme-option" data-theme="pastel" style="background: linear-gradient(135deg, #a29bfe 0%, #fd79a8 100%);"></div>
        <div class="theme-option" data-theme="ocean" style="background: linear-gradient(135deg, #0984e3 0%, #00cec9 100%);"></div>
    </div>
</div>

<script src="./js/game.js">

</script>
</body>
</html>